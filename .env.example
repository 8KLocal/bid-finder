# It's Workplace (ITS WORKPLACE INC) — itsworkplace.com Stripe account.
# Copy to .env for `node scripts/dev-server.mjs` or set these in the host
# that runs the /api routes (Vercel, or any Node server).
# Never commit real keys. Never put secret keys in assets/config.js.
# claimWebhookUrl in assets/config.js is a public URL only. Leave it empty.
# Do not put a webhook token or signing secret in that file.

# --- Stripe Checkout Session (server only) ---
# Secret or restricted key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Price id for Starter, $29/month. Dashboard → Product catalog → Starter → price_...
STRIPE_PRICE_ID=
# Where Stripe sends the customer after payment. No trailing path needed.
PUBLIC_SITE_URL=https://8klocal.github.io/bid-finder

# --- Stripe on GitHub Pages (public, safe to put in assets/config.js) ---
# Payment Link for the same $29/month Starter price. buy.stripe.com URL.
# Success URL on that link: https://8klocal.github.io/bid-finder/?checkout=success
STRIPE_PAYMENT_LINK=
# Optional publishable key, only needed for a Stripe Buy Button.
STRIPE_PUBLISHABLE_KEY=
STRIPE_BUY_BUTTON_ID=
# Optional Customer Portal login link (billing.stripe.com).
STRIPE_PORTAL_LINK=

# --- Model drafts (server only) ---
# OpenAI-compatible key. When this is empty, the site still writes a structured
# draft in the browser and says the model is not configured.
AI_API_KEY=
# Optional. Default is OpenAI.
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional. Lock the Node API to the public site. The PHP server uses ALLOWED_ORIGINS.
# CORS_ORIGIN=https://8klocal.github.io

# --- PHP bid service (server/). Never commit real values. ---
# xAI. Grok runs only after Stripe confirms the per-bid payment.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_API_BASE=https://api.x.ai/v1
# Stripe Checkout for $20 bid writing and mailing. Restricted key is fine.
STRIPE_WEBHOOK_SECRET=
OPS_EMAIL=
ALLOWED_ORIGINS=https://8klocal.github.io,https://itsworkplace.com
APP_BASE_URL=https://bids.example.com
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
MAIL_FROM=hello@itsworkplace.com
MAIL_FROM_NAME=It's Workplace
SENDGRID_API_KEY=
# This product's own LetterStream account. Not another company's keys.
LETTERSTREAM_API_ID=
LETTERSTREAM_API_KEY=
LETTERSTREAM_API_BASE=https://www.letterstream.com/api/
LETTERSTREAM_TEST=1
MAIL_RETENTION_DAYS=14
FEED_INDEX_URL=https://8klocal.github.io/bid-finder/data/feed/index.json
DB_PATH=server/storage/app.sqlite
