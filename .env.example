# It's Workplace (ITS WORKPLACE INC) — itsworkplace.com Stripe account.
# Copy to .env for `node scripts/dev-server.mjs` or set these in the host
# that runs the /api routes (Vercel, or any Node server).
# Never commit real keys. Never put secret keys in assets/config.js.

# --- Stripe Checkout Session (server only) ---
# Secret or restricted key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Price id for Starter, $29/month. Dashboard → Product catalog → Starter → price_...
STRIPE_PRICE_ID=
# Where Stripe sends the customer after payment. No trailing path needed.
PUBLIC_SITE_URL=https://8klocal.github.io/bid-finder

# --- Stripe on GitHub Pages (public, safe to put in assets/config.js) ---
# Payment Link for the same $29/month Starter price. buy.stripe.com URL.
# Success URL on that link: https://8klocal.github.io/bid-finder/?checkout=success
STRIPE_PAYMENT_LINK=
# Optional publishable key, only needed for a Stripe Buy Button.
STRIPE_PUBLISHABLE_KEY=
STRIPE_BUY_BUTTON_ID=
# Optional Customer Portal login link (billing.stripe.com).
STRIPE_PORTAL_LINK=

# --- Model drafts (server only) ---
# OpenAI-compatible key. When this is empty, the site still writes a structured
# draft in the browser and says the model is not configured.
AI_API_KEY=
# Optional. Default is OpenAI.
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional. Lock the API to the public site. Default allows any origin.
# CORS_ORIGIN=https://8klocal.github.io
